====
/* While the location sheet is open, Escape closes it and Tab stays inside it. */
document.addEventListener("keydown",e=>{const sh=document.getElementById("locsheet");if(!sh)return;
  if(e.key==="Escape"){closeLoc();return}
  if(e.key!=="Tab")return;
  const f=[...sh.querySelectorAll("button,select,input,a[href]")].filter(x=>!x.disabled&&x.offsetParent!==null);if(!f.length)return;
  const first=f[0],last=f[f.length-1],at=document.activeElement;
  if(!sh.contains(at)||(!e.shiftKey&&at===last)){e.preventDefault();first.focus()}
  else if(e.shiftKey&&at===first){e.preventDefault();last.focus()}});
