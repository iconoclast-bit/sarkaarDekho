/* Works out the state from the device's position. Only a position rounded to one decimal place (about 10 km)
   leaves the device, the request carries no cookies or referrer, and it gives up after 8 seconds. */
function locate(){
  const say=t=>{const m=document.getElementById("locmsg");if(m)m.textContent=t};
  if(!navigator.geolocation){say("Your browser can't share location. Please choose from the list.");return}
  say("Finding you"+String.fromCharCode(8230));
  navigator.geolocation.getCurrentPosition(p=>{
    const ctl="AbortController" in window?new AbortController():null,timer=setTimeout(()=>{if(ctl)ctl.abort()},8000);
    fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${p.coords.latitude.toFixed(1)}&longitude=${p.coords.longitude.toFixed(1)}&localityLanguage=en`,{signal:ctl?ctl.signal:undefined,credentials:"omit",referrerPolicy:"no-referrer",cache:"no-store"})
      .then(r=>{if(!r.ok)throw new Error("lookup failed");return r.json()})
      .then(j=>{
        const name=String(j&&j.principalSubdivision||"").replace(/^National Capital Territory of /,"");
        const hit=STATES.find(s=>s.toLowerCase()===name.toLowerCase());
        if(!j||j.countryCode!=="IN"||!hit){say("We couldn't match your position to a state. Please choose from the list.");return}
        const sel=document.getElementById("lstate");if(!sel)return;
        sel.value=hit;sel.dispatchEvent(new Event("change",{bubbles:true}));
        say("Found: "+hit+". Check it's right, then continue.");
      })
      .catch(()=>say("Couldn't look up your state. Please choose from the list."))
      .then(()=>clearTimeout(timer));
  },()=>say("Location wasn't shared. Please choose from the list."),{enableHighAccuracy:false,timeout:10000,maximumAge:600000})}
