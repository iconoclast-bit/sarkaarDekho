const DESCS={
  home:"Compare India's parties before you vote: what each government promised and delivered at the Centre and in every state, side by side. Every claim is sourced, and independent audit findings are shown next to official numbers.",
  decide:"Pick the issues that matter most to you and see, side by side, how each side's record and promises line up. No score, no ranking — just your own answers.",
