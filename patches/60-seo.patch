  promises:"Every measurable manifesto promise from the Centre's governments since 2004, checked against its own target and deadline.",
  charts:"India's key numbers from 2004 to today, charted year by year, with each government's time in power shaded for comparison.",
  manifesto:"What the Congress-led UPA and BJP-led NDA promised in their 2024 manifestos, issue by issue, sourced from the documents themselves.",
  about:"How SarkarDekho sources its numbers, what it includes and leaves out, and where the data is weak. Not affiliated with any party.",
  search:"Search promises, schemes, issues and states across SarkarDekho."
};
function seo(t,d,home){
  const full=home?t:t+" · SarkarDekho";
  const byName=n=>document.querySelector(`meta[name="${n}"]`),byProp=n=>document.querySelector(`meta[property="${n}"]`);
  let el=byName("description");if(el)el.content=d;
  el=byProp("og:title");if(el)el.content=full;
  el=byProp("og:description");if(el)el.content=d;
  el=byProp("og:url");if(el)el.content=location.href;
  el=byName("twitter:title");if(el)el.content=full;
  el=byName("twitter:description");if(el)el.content=d;
}
